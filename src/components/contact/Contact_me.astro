---
import BackgroundContactAstroComponent from "./BackgroundContact.astro";
import { Mail, MapPin, Phone } from "lucide-astro";
---

<section>
    <div class="relative overflow-hidden">
        <div class="relative z-50">
            <!-- inicio de seccion -->
             <div class="max-w-7xl mx-auto px-4 py-12">
                <!-- primer contenedor hijo -->
                 <div class="flex flex-col items-center">
                    <h1 class="p-2 text-center text-5xl mt-6 sm:text-4xl md:text-5xl"> Contacto </h1>
                    <div class="w-30 mt-3 p-0.5 inline-flex bg-linear-to-r from-orange-400 to-green-600"></div>
                    <p class="py-6 text-base sm:text-lg text-muted-foreground leading-relaxed text-gray-500 text-center">¿Tienes un proyecto en mente? Hablemos y hagámoslo realidad</p>
                 </div>
                 <!-- segundo contenedor hijo -->
                  <div class=" grid md:grid-cols-2 gap-12"> <!-- contenedor padre -->
                    <!-- primer contenedor hijo, informacion de contacto -->
                    <div class="space-y-6">
                        <h1 class="text-2xl mb-6"> Informacion de Contacto </h1>
                        <div class="rounded-lg border border-gray-400 flex items-center gap-4 p-4">
                            <!-- contenedor email -->
                            <div class="p-3 rounded-full bg-mauve-200">
                                <Mail />
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-bold"> Email </span>
                                <span class="text-base"> monterocamilo99@hotmail.com</span>
                            </div>
                        </div>
                        <!-- contenedor telefono -->
                        <div class="rounded-lg border border-gray-400 flex items-center gap-4 p-4">
                            <div class="p-3 rounded-full bg-mauve-200">
                                <Phone />
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-bold"> Teléfono </span>
                                <span class="text-base"> +34 604 14 19 48</span>
                            </div>
                        </div>
                        <!-- contenedor ubicacion -->
                        <div class="rounded-lg border border-gray-400 flex items-center gap-4 p-4">
                            <div class="p-3 rounded-full bg-mauve-200">
                                <MapPin />
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-bold"> Ubicación </span>
                                <span class="text-base"> Valencia, España </span>
                            </div>
                        </div>
                    </div>
                    <!-- segundo contenedor hijo, formaluario -->
                     <div>
                        <form action="" class="space-y-6">
                            <!-- label nombre -->
                            <div>
                                <label for="" class="block mb-2"> Nombre: </label>
                                <input type="text" id="name" class="w-full px-4 py-3 rounded-lg bg-mauve-200 border border-gray-400" placeholder="Tu nombre">
                            </div>
                            <div>
                                <label for="" class="block mb-2"> Email: </label>
                                <input type="email" id="email" class="w-full px-4 py-3 rounded-lg bg-mauve-200 border border-gray-400" placeholder="tu@email.com">
                            </div>
                            <div>
                                <label for="" class="block mb-2"> Mensaje </label>
                                <textarea name="message" id="message" rows="5" class="w-full px-4 py-3 rounded-lg bg-mauve-200 border-gray-400" placeholder="Tu mensaje..."></textarea>
                            </div>
                            <button type="submit" class="w-full px-8 py-3 bg-black text-white rounded-lg"> Enviar Mensaje </button>
                        </form>
                     </div>
                  </div>
             </div>
        </div>
    </div>
</section>