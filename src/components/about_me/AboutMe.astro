---
import BackgroundAboutme from "./BackgroundAboutme.astro";
import HtmlIcon from "../icons/iconHtml.astro";
import RocketIcon from "../icons/rocketIcon.astro";
import UserIcon from "../icons/userIcon.astro";
import AwardsIcon from "../icons/awardsIcon.astro";
---

<section>
  <div class="relative overflow-hidden">
    <BackgroundAboutme />
    <div class="relative z-10">
      <!-- contenedor padre -->
      <div class="py-10 bg-mauve-100">
        <!-- div hijos donde estaran, el titulo y los contenedores de informacion -->
        <div
          class="flex flex-col place-content-center place-items-center p-2"
        >
          <h1 class="p-2 text-center text-5xl mt-6">Sobre Mí</h1>
          <div class="w-30 mt-3 p-0.5 inline-flex bg-linear-to-r from-orange-400 to-green-600"></div>
          <div
            class="flex flex-row justify-center p-10 gap-10"
          >
            <!-- contenedores hijos de imagen e informacion -->
            <div
              class=" inline-flex p-1 bg-linear-to-r from-orange-400 to-green-600 from-25% shadow-lg rounded-2xl"
            >
              <div
                class="size-150 flex items-center justify-center text-9xl bg-mauve-100 rounded-2xl"
              >
                🚀
              </div>
            </div>
            <div class="w-150 flex flex-col gap-10 p-10 place-content-center">
                <!-- contenedores hijos para el texto y  cajas de proyectos-->
                 <div class="space-y-6">
                    <p class="text-lg text-muted-foreground leading-relaxed">Soy un desarrollador apasionado con experiencia en crear soluciones web modernas y escalables. Me especializo en tecnologías como React, TypeScript, Node.js y más.</p>
                    <p class="text-lg text-muted-foreground leading-relaxed">Mi enfoque está en escribir código limpio, mantenible y en crear experiencias de usuario excepcionales. Siempre estoy buscando aprender nuevas tecnologías y mejorar mis habilidades.</p>
                 </div>
                 <div class="grid grid-cols-2 gap-4 justify-items-stretch">
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <HtmlIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-2xl">50+</p>
                        <p class="text-sm text-gray-500">Proyectos Completados</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <RocketIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-2xl">1+</p>
                        <p class="text-sm text-gray-500">Años de Experiencia</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <UserIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-2xl">1+</p>
                        <p class="text-sm text-gray-500">Clientes Satisfechos</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <AwardsIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-2xl mb-1">1+</p>
                        <p class="text-sm text-gray-500">Premios Ganados</p>
                    </div>
                 </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
