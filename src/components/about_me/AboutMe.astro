---
import BackgroundAboutme from "./BackgroundAboutme.astro";
import HtmlIcon from "../icons/iconHtml.astro";
import RocketIcon from "../icons/rocketIcon.astro";
import UserIcon from "../icons/userIcon.astro";
import AwardsIcon from "../icons/awardsIcon.astro";
---

<section>
  <div class="relative overflow-hidden">
    <BackgroundAboutme />
    <div class="relative z-50">
      <!-- contenedor padre -->
      <div class="py-12 px-4 bg-mauve-200 sm:px-6 lg:px-8">
        <!-- div hijos donde estaran, el titulo y los contenedores de informacion -->
        <div
          class="flex flex-col mx-auto max-w-6xl items-center"
        >
          <h1 class="p-2 text-center text-5xl mt-6 sm:text-4xl md:text-5xl fade-up visible">Sobre Mí</h1>
          <div class="w-30 mt-3 p-0.5 inline-flex bg-linear-to-r from-orange-400 to-green-600"></div>
          <div
            class="flex flex-col items-center mt-10 gap-10 w-full lg:flex-row lg:justify-center lg:items-center"
          >
            <!-- contenedores hijos de imagen e informacion -->
            <div
              class=" inline-flex p-1 bg-linear-to-r from-orange-400 to-green-600 from-25 rounded-2xl"
            >
              <div
                class="size-64 sm:size-80 md:size-96 lg:size-150 flex items-center justify-center text-7xl bg-mauve-200 rounded-2xl sm:text-8xl md:text-9xl"
              >
                🚀
              </div>
            </div>
            <div class="w-full max-w-xl flex flex-col gap-8 place-content-center lg:max-w-2xl">
                <!-- contenedores hijos para el texto y  cajas de proyectos-->
                 <div class="space-y-6">
                    <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">Soy un desarrollador apasionado con experiencia en crear soluciones web modernas y escalables. Me especializo en tecnologías como React, TypeScript, Node.js y más.</p>
                    <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">Mi enfoque está en escribir código limpio, mantenible y en crear experiencias de usuario excepcionales. Siempre estoy buscando aprender nuevas tecnologías y mejorar mis habilidades.</p>
                 </div>
                 <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 justify-items-stretch">
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <HtmlIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-sm mb-1 md:text-2xl">50+</p>
                        <p class="text-sm text-gray-500">Proyectos Completados</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <RocketIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-sm mb-1 md:text-2xl">1+</p>
                        <p class="text-sm text-gray-500">Años de Experiencia</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <UserIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-sm mb-1 md:text-2xl">1+</p>
                        <p class="text-sm text-gray-500">Clientes Satisfechos</p>
                    </div>
                    <div class="text-center p-4 rounded-lg bg-background border border-border hover:border-chart-1 transition-colors hover:border-orange-400 h-30 flex flex-col place-items-center place-content-center">
                        <AwardsIcon class="w-8 h-8 stroke-orange-500"/>
                        <p class="text-sm mb-1 md:text-2xl">1+</p>
                        <p class="text-sm text-gray-500">Premios Ganados</p>
                    </div>
                 </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
