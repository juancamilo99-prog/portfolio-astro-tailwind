---
import logo from "./src/assets/logo.png";
import HamburgerButton from './HamburgerButton.astro';
import MobileMenu from './MobileMenu.astro';
---

<header id="header-navegation" class="bg-slate-white backdrop-blur-2xl text-black shadow-md top-0 z-60 fixed w-full">
    <div class="max-w-7xl px-2 mx-auto md:px-8 lg:px-12 py-2">
        <div class="flex flex-row justify-between items-center gap-4">
            <img src={logo.src} alt="Logo" class="w-20 h-20"/>
            <nav class="hidden md:block">
                <ul class="flex flex-wrap gap-3 md:gap-6 text-sm md:text-base font-medium">
                    <li><a href="/home" class="relative inline-block text-black hover:text-primary-texto transition-colors duration-300 
                        after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-amber-500
                        after:transition-all after:duration-300 hover:after:w-full">Inicio</a></li>
                    <li><a href="/about" class="relative inline-block text-black hover:text-primary-texto transition-colors duration-300
                        after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-amber-500
                        after:transition-all after:duration-300 hover:after:w-full">Sobre mi</a></li>
                    <li><a href="/skills" class="relative inline-block text-black hover:text-primary-texto transition-colors duration-300
                        after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-amber-500
                        after:transition-all after:duration-300 hover:after:w-full">Habilidades</a></li>
                    <li><a href="/projects" class="relative inline-block text-black hover:text-primary-texto transition-colors duration-300
                        after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-amber-500
                        after:transition-all after:duration-300 hover:after:w-full">Proyectos</a></li>
                    <li><a href="/contact" class="relative inline-block text-black hover:text-primary-texto transition-colors duration-300
                        after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-amber-500
                        after:transition-all after:duration-300 hover:after:w-full">Contactos</a></li>
                </ul>
            </nav>
            <HamburgerButton />
            <MobileMenu />
        </div>
    </div>
</header>

<script src="../../scripts/mobileMenu.js"></script>